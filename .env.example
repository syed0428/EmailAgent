# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emailagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text

# ─── Sentence Transformers (alternative local embedding) ─────────────────────
# Set EMBEDDING_BACKEND=sentence_transformers to use this instead of Ollama
EMBEDDING_BACKEND=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ─── Gmail OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

# ─── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_secret_key
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# ─── Embedding Dimensions ────────────────────────────────────────────────────
# all-MiniLM-L6-v2  → 384
# nomic-embed-text  → 768
# text-embedding-3-small → 1536
EMBEDDING_DIMENSIONS=384
